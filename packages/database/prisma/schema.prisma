
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//Every time price poller receives a trade from Binance websocket it will come here
model Trade {
  id        BigInt   @default(autoincrement())
  symbol    String
  price     BigInt
  tradeId   BigInt        //Binance's own trade ID for avoid inserting duplicates
  timestamp DateTime @db.Timestamptz(3)
  quantity  Decimal  @db.Decimal(20, 8) // 20 digits allowed and 8 digits after decimal

  @@id([id, timestamp])
  @@unique([symbol, tradeId, timestamp]) // Required for TimescaleDB hypertable
  @@index([symbol, timestamp]) // for quick indexing and finding
}

// Historical Binance OHLCV bars used by long-range charts. Kept separate from
// Trade so years of candles don't inflate the live trade tape.
model MarketCandle {
  symbol       String   @db.VarChar(12)
  interval     String   @db.VarChar(3)
  timestamp    DateTime @db.Timestamptz(3)
  open         BigInt
  high         BigInt
  low          BigInt
  close        BigInt
  baseVolume   Decimal  @db.Decimal(38, 12)
  quoteVolume  Decimal  @db.Decimal(38, 12)
  tradeCount   Int

  @@id([symbol, interval, timestamp])
  @@map("market_candles")
}

// User accounts with authentication and balances
model User {
  userId        String   @id
  email         String   @unique
  password      String   // Empty string for OAuth users
  version       Int      @default(0)
  balanceCents  Float      @default(500000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // OAuth fields
  provider      String?  // "google", "github", or null for email/password
  providerId    String?  // OAuth provider's user ID
  emailVerified Boolean  @default(false)
  avatarUrl     String?  // Profile picture from OAuth
  sessions      AuthSession[]
  watchlist     WatchMarket[]
  priceAlerts   PriceAlert[]

  @@index([provider, providerId])
  @@map("users")
}

model WatchMarket {
  userId String
  asset String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, asset])
  @@map("user_watchlist")
}

model PriceAlert {
  id String @id
  userId String
  asset String
  targetPrice Float
  direction String
  triggeredAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt])
  @@map("price_alerts")
}

// Closed trading positions with PnL
model ClosedOrder {
  feesRecorded Boolean @default(false)
  positionId String?
  notionalCents Float @default(0)
  entryFeeCents Float @default(0)
  exitFeeCents Float @default(0)
  netPnlCents Float @default(0)
  orderId          String   @id
  userId           String
  asset            String
  type             String
  margin           Float
  initialMargin    Float      // Original margin when opened
  addedMargin      Float      @default(0) // Additional margin added
  leverage         Int
  openPrice        Float
  closePrice       Float
  liquidationPrice Float
  takeProfit       Float?
  stopLoss         Float?
  pnl              Float
  closeReason      String
  closeMessage     String?
  openedAt         DateTime
  closedAt         DateTime
  createdAt        DateTime @default(now())

  // Trailing stop loss fields (JSON stored as String for simplicity)
  trailingStopLossEnabled       Boolean @default(false)
  trailingStopLossDistance      Float?
  trailingStopLossHighestPrice  Float?
  trailingStopLossLowestPrice   Float?

  @@index([userId])
  @@index([closedAt])
  @@map("closed_orders")
}

// Periodic snapshots of user balances (every 10 seconds)
model UserSnapshot {
  id           Int      @id @default(autoincrement())
  userId       String
  balanceCents Float
  snapshotAt   DateTime @default(now())

  @@index([userId, snapshotAt])
  @@map("user_snapshots")
}

// Periodic snapshots of open orders (every 10 seconds)
model OrderSnapshot {
  id               Int      @id @default(autoincrement())
  orderId          String
  userId           String
  asset            String
  type             String
  margin           Float
  initialMargin    Float      // Original margin when opened
  addedMargin      Float      @default(0) // Additional margin added
  leverage         Int
  openPrice        Float
  liquidationPrice Float
  takeProfit       Float?
  stopLoss         Float?
  openedAt         DateTime
  snapshotAt       DateTime @default(now())

  // Trailing stop loss fields
  trailingStopLossEnabled       Boolean @default(false)
  trailingStopLossDistance      Float?
  trailingStopLossHighestPrice  Float?
  trailingStopLossLowestPrice   Float?

  @@index([orderId, snapshotAt])
  @@map("order_snapshots")
}

// Currently active orders (persistent state)
model ActiveOrder {
  feesRecorded Boolean @default(true)
  needsReview Boolean @default(false)
  notionalCents Float
  entryFeeCents Float @default(0)
  orderId          String   @id
  userId           String
  asset            String
  type             String
  margin           Float
  initialMargin    Float      // Original margin when opened
  addedMargin      Float      @default(0) // Additional margin added
  leverage         Int
  openPrice        Float
  liquidationPrice Float
  takeProfit       Float?
  stopLoss         Float?
  openedAt         DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Trailing stop loss fields
  trailingStopLossEnabled       Boolean @default(false)
  trailingStopLossDistance      Float?
  trailingStopLossHighestPrice  Float?
  trailingStopLossLowestPrice   Float?

  @@index([userId])
  @@map("active_orders")
}

// Platform profit state (singleton  always id = 1)
model PlatformProfit {
  id            Int      @id @default(1)
  totalProfit   Int      // Total platform profit in cents
  openTrades    Int      // Count of currently open trades
  closedTrades  Int      // Count of closed trades
  totalTrades   Int      // Total trades (open + closed)
  lastUpdated   DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@map("platform_profit")
}

// Mutation receipt and outbox: written in the same account transaction.
model AccountEvent {
  id String @id @default(uuid())
  userId String
  version Int
  kind String
  positionId String?
  payload Json
  createdAt DateTime @default(now())
  deliveredAt DateTime?
  @@unique([userId, version])
  @@index([userId, createdAt])
  @@index([deliveredAt, createdAt])
}
model MutationReceipt {
  userId String
  key String
  fingerprint String
  response Json
  createdAt DateTime @default(now())
  @@id([userId, key])
}
model EquitySnapshot {
  id String @id @default(uuid())
  userId String
  availableCents Float
  reservedCents Float
  pnlCents Float?
  equityCents Float?
  stale Boolean
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model LoginCode {
  challenge String?
  code String @id
  userId String
  expiresAt DateTime
}

model AuthSession {
  id String @id
  userId String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user User @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}
