{
  "name": "orbit-ledger",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "start": "bun run --cwd apps/Backend start",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prisma": "bun --bun packages/database/node_modules/prisma/build/index.js --config packages/database/prisma.config.ts",
    "seed-data": "bun run scripts/seed-historical-data.ts",
    "test": "bun test packages/shared/tests apps/Price_Poller/tests",
    "test:integration": "bun test apps/Backend/tests"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "bun-types": "latest",
    "prettier": "^3.6.2",
    "prisma": "^7.6.0",
    "turbo": "^2.11.9",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/client": "^7.6.0",
    "@prisma/client-runtime-utils": "^7.6.0",
    "jsonwebtoken": "^9.0.2",
    "redis": "^5.9.0",
    "ws": "^8.22.0"
  }
}
