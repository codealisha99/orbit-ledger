{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run prisma generate && bun run --cwd apps/Websocket build"
  },
  "deploy": {
    "startCommand": "bun run --cwd apps/Websocket start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
