{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run prisma generate && bun run --cwd apps/Price_Poller build"
  },
  "deploy": {
    "startCommand": "bun run --cwd apps/Price_Poller start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": "/health"
  }
}
