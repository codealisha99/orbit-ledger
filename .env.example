# Copy this file to .env for local development. Never commit .env files.
DATABASE_URL=postgresql://postgres:password@localhost:5432/orbitledger?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
WEBSOCKET_PORT=8080
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v2
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8080
INITIAL_BALANCE_USD=5000

# Optional OAuth providers. Callback endpoints use /api/v2/auth/<provider>/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v2/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v2/auth/github/callback

# Optional Kafka historical data pipeline.
KAFKA_BROKERS=

# Frontend server-only API proxy; public API URL is used for OAuth redirects.
API_URL=http://localhost:5000/api/v2
DATABASE_POOL_SIZE=10
# Mount this path on a persistent volume in production.
INGEST_SPOOL_PATH=.data/market-spool.sqlite
# Optional local poller health endpoint. Railway uses its service PORT automatically.
# POLLER_HEALTH_PORT=8090
# Enable only after legacy snapshot recovery has been reviewed.
LEGACY_SNAPSHOT_RETENTION_DAYS=0
